{
  "name": "fhe-insurance-contracts",
  "version": "1.0.0",
  "description": "FHE-based insurance smart contracts",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "precheck": "hardhat run scripts/pre-deploy-check.js --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy-insurance.js --network sepolia",
    "deploy:local": "hardhat run scripts/deploy-insurance.js --network localhost",
    "deploy": "npm run precheck && npm run deploy:sepolia",
    "verify": "hardhat verify --network sepolia"
  },
  "keywords": [
    "fhe",
    "insurance",
    "privacy",
    "blockchain",
    "solidity"
  ],
  "author": "FHE Insurance Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.3"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.8.0",
    "@openzeppelin/contracts": "^5.4.0"
  }
}
