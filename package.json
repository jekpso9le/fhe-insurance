{
  "name": "veilsure",
  "version": "1.0.0",
  "description": "VeilSure - FHE-powered privacy-preserving insurance platform",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy-insurance.js",
    "deploy:sepolia": "hardhat run scripts/deploy-insurance.js --network sepolia",
    "precheck": "hardhat run scripts/pre-deploy-check.js --network sepolia",
    "test": "hardhat test",
    "test:policy": "hardhat test test/PolicyRegistry.test.ts",
    "test:claims": "hardhat test test/ClaimsManager.test.ts",
    "test:risk": "hardhat test test/RiskAssessment.test.ts",
    "clean": "hardhat clean",
    "typechain": "hardhat compile && hardhat typechain"
  },
  "keywords": [
    "fhe",
    "insurance",
    "privacy",
    "ethereum",
    "smart-contracts",
    "zama",
    "fhevm"
  ],
  "author": "VeilSure Team",
  "license": "MIT",
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.3.0-1",
    "@fhevm/mock-utils": "^0.3.0-1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.8",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.1",
    "dotenv": "^16.4.5",
    "hardhat": "^2.26.0",
    "hardhat-gas-reporter": "^1.0.10",
    "mocha": "^11.7.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.9.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@zama-fhe/relayer-sdk": "^0.3.0-5",
    "encrypted-types": "^0.0.4",
    "ethers": "^6.15.0"
  }
